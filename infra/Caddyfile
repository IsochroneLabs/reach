# Local Caddy (image from infra/web.Dockerfile): serves the web build (web/dist in /srv) and
# proxies /api to FastAPI. Production (HTTPS via sslip.io) gets its own site block in P8.
:80 {
	encode gzip
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		# Vite fingerprints everything under /assets: cache for a year; revalidate the page itself.
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header / Cache-Control "no-cache"
		header /index.html Cache-Control "no-cache"
		file_server
	}
}
