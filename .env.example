# Copy to .env (git-ignored) and replace every "change-me". Docker Compose reads .env
# automatically; the pipeline and the API read the same variables. Production: the same file on
# the server, never in GitHub (docs/deployment.md). Deploy secrets for GitHub Actions are listed in
# docs/deployment.md, not here.

# Compose project name (default "reach"). Set another name for a second checkout on the same
# machine; otherwise its `make up` replaces the containers of the first.
# COMPOSE_PROJECT_NAME=reach-second

# --- PostGIS ---------------------------------------------------------------------------------
# Database name and superuser (used only to create roles and run migrations).
POSTGRES_DB=reach
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Passwords of the roles (docs/data_contract.md); `make migrate` creates the roles and sets them.
# supervisor_read is [VERIFY] (A5): kept until the course requirement is checked.
APP_READ_PASSWORD=change-me
PIPELINE_WRITE_PASSWORD=change-me
SUPERVISOR_READ_PASSWORD=change-me
# Host port for PostGIS; local development only, always bound to 127.0.0.1.
DB_PORT=5432

# --- Connection strings ------------------------------------------------------------------------
# Keep ports and passwords in these URLs in sync with the values above. "localhost" when run on
# the host via `make pipeline`; Compose services use the host name "db".
DATABASE_URL_PIPELINE=postgresql://pipeline_write:change-me@localhost:5432/reach
# Superuser connection for `make migrate` (roles, passwords, migrations).
DATABASE_URL_ADMIN=postgresql://postgres:change-me@localhost:5432/reach
# API connects as app_read and reads only the "current" schema.
DATABASE_URL_API=postgresql://app_read:change-me@db:5432/reach
# Optional, tests only: superuser URL of a disposable PostGIS for `uv run pytest -m db`.
# REACH_TEST_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/postgres

# --- Routing -----------------------------------------------------------------------------------
# Valhalla for the pipeline on the host (localhost:<VALHALLA_PORT>); Compose services use
# http://valhalla:8002. Required: the pipeline stops if it is missing (notes N5).
VALHALLA_URL=http://localhost:8002
# Host port for Valhalla; local development only, bound to 127.0.0.1, never in production.
VALHALLA_PORT=8002
# Transit engine URL and port follow with the T1 decision (S1.7).

# --- API ---------------------------------------------------------------------------------------
# Host port of the API for local development (`npm run dev` proxies /api to it), bound to
# 127.0.0.1. Production exposes the API only through the tunnel or Caddy (D2).
API_PORT=8000

# --- Pipeline ----------------------------------------------------------------------------------
# Config file for the pipeline and the API (config/test_clip.yaml for the test clip).
REACH_CONFIG=config/config.yaml
# Team chat webhook for failed refresh runs (O9). Empty = no notification.
FAILURE_WEBHOOK_URL=

# --- Production only (S1.5, depends on D1/D2) ---------------------------------------------------
# Pull token for private GHCR images (classic token with read:packages); empty if images are public.
# GHCR_READ_TOKEN=
