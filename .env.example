# Copy to .env (git-ignored) and replace every "change-me". Docker Compose reads .env
# automatically; the pipeline and the API read the same variables.

# --- PostGIS ---------------------------------------------------------------------------------
# Database name and superuser (used only to create roles and run migrations).
POSTGRES_DB=reach
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Passwords of the three roles (arch. §8); `make migrate` creates the roles (infra/db/roles.sql)
# and sets these passwords.
APP_READ_PASSWORD=change-me
PIPELINE_WRITE_PASSWORD=change-me
SUPERVISOR_READ_PASSWORD=change-me
# Host port for PostGIS; local development only, always bound to 127.0.0.1.
DB_PORT=5432

# --- Connection strings ------------------------------------------------------------------------
# Pipeline (publish stage) connects as pipeline_write. "localhost" when run on the host via
# `make pipeline`; the Compose services use the host name "db" instead.
# Keep port and passwords in these URLs in sync with DB_PORT and the *_PASSWORD values above.
DATABASE_URL_PIPELINE=postgresql://pipeline_write:change-me@localhost:5432/reach
# Superuser connection (POSTGRES_USER/POSTGRES_PASSWORD) for `make migrate`: creates the roles,
# sets their passwords from the *_PASSWORD values above and applies infra/db/migrations. When
# set, `publish` also runs the (idempotent) migrations first. Leave empty to migrate by hand.
DATABASE_URL_ADMIN=postgresql://postgres:change-me@localhost:5432/reach
# API connects as app_read and reads only the "current" schema.
DATABASE_URL_API=postgresql://app_read:change-me@db:5432/reach
# Optional, tests only: superuser URL of a disposable PostGIS for `uv run pytest -m db`; the
# tests create and drop their own database reach_test_<random> on it (roles are reused).
# REACH_TEST_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/postgres

# --- Valhalla ----------------------------------------------------------------------------------
# Routing service URL. localhost:8002 from the host; Compose services use http://valhalla:8002.
VALHALLA_URL=http://localhost:8002
# Host port for Valhalla; local development only, bound to 127.0.0.1, never in production.
VALHALLA_PORT=8002
# VALHALLA_DIR (tile directory = <data_dir>/valhalla of the selected config), ELEVATION and BBOX
# are set by `make up` / `make refresh` for Docker Compose; do not set them here.

# --- Pipeline ----------------------------------------------------------------------------------
# Config file for the pipeline (config/test_clip.yaml for the test clip).
REACH_CONFIG=config/config.yaml
# Team chat webhook for failed runs (O10, O14). Empty = no notification.
FAILURE_WEBHOOK_URL=

# --- Web ---------------------------------------------------------------------------------------
# Host port of the local Caddy (frontend + /api), bound to 127.0.0.1.
WEB_PORT=8080
