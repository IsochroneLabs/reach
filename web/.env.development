# Build-time settings of the frontend (Vite, `import.meta.env`); committed, no secrets.
# The same keys are in .env.production; both must stay in sync (web/AGENTS.md).
# Base path of the reach API (same origin through Caddy, or the Vite dev proxy below).
VITE_API_BASE=/api
# Basemap style: OpenFreeMap Positron, no API key (decided in P6).
VITE_BASEMAP_STYLE=https://tiles.openfreemap.org/styles/positron
# Attribution required by the basemap, always shown on the map next to the data sources.
VITE_BASEMAP_ATTRIBUTION=© OpenMapTiles © OpenStreetMap contributors
# Documentation linked from the data & validation page.
VITE_DOCS_URL=https://github.com/IsochroneLabs/reach/blob/dev/docs
# `npm run dev` only: where the dev server proxies /api (Caddy of `make up`).
VITE_DEV_API_PROXY=http://127.0.0.1:8080
