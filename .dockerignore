# Build context of infra/*.Dockerfile: only what the images copy (data/, .venv/, caches stay out).
*
!pyproject.toml
!uv.lock
!.python-version
!api/pyproject.toml
!api/src/
!pipeline/pyproject.toml
!config/
!infra/Caddyfile
!web/package.json
!web/package-lock.json
!web/index.html
!web/vite.config.ts
!web/tsconfig*.json
!web/.env.production
!web/src/
**/__pycache__
